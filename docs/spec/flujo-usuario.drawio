  <diagram id="flujo" name="flujo">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1340" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="flujo-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#2C2C2A;" value="Vigente · flujo de usuario de un cambio" vertex="1">
          <mxGeometry x="40" y="0" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="flujo-admin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#FDF1E7;strokeColor=#B4690E;fontColor=#7A4508;dashed=1;" value="&lt;b&gt;Administrador configura el proyecto una vez&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Conecta su software, define espacios, documentos, elenco y mapa de dependencias. Hoy vive en código: apps/api/src/scenario&lt;/span&gt;" vertex="1">
          <mxGeometry x="40" y="40" width="920" height="56" as="geometry" />
        </mxCell>
        <mxCell id="flujo-laneA" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#D3D1C7;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fontColor=#5F5E5A;spacingTop=6;" value="Autor del cambio" vertex="1">
          <mxGeometry x="40" y="115" width="260" height="1120" as="geometry" />
        </mxCell>
        <mxCell id="flujo-laneB" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#D3D1C7;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fontColor=#5F5E5A;spacingTop=6;" value="Vigente" vertex="1">
          <mxGeometry x="320" y="115" width="340" height="1120" as="geometry" />
        </mxCell>
        <mxCell id="flujo-laneC" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#D3D1C7;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fontColor=#5F5E5A;spacingTop=6;" value="Afectados y dueños" vertex="1">
          <mxGeometry x="680" y="115" width="280" height="1120" as="geometry" />
        </mxCell>
        <mxCell id="flujo-a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;" value="&lt;b&gt;Trabaja en su software&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Guarda el modelo en Revit o sube una revisión a su espacio: Drive, planilla, correo, WhatsApp o libro de obra&lt;/span&gt;" vertex="1">
          <mxGeometry x="60" y="160" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="flujo-b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;" value="&lt;b&gt;Captura la revisión&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Add-in de Revit (real) o ETL (simulado) → POST /api/revisions, partida en fragmentos&lt;/span&gt;" vertex="1">
          <mxGeometry x="340" y="160" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="flujo-b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;" value="&lt;b&gt;Compara cada hecho con lo vigente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;El texto libre lo lee Claude o respuestas fijas; bajo 0,7 no cuenta&lt;/span&gt;" vertex="1">
          <mxGeometry x="340" y="255" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flujo-b3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;" value="¿Cambia un dato y la fuente manda sobre él?" vertex="1">
          <mxGeometry x="340" y="340" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flujo-c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;" value="&lt;b&gt;Dueño del valor: discrepancia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Un WhatsApp o un folio no manda. Descarta o espera el plano que lo respalde&lt;/span&gt;" vertex="1">
          <mxGeometry x="700" y="345" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="flujo-b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;" value="&lt;b&gt;Abre la propuesta, el PR de la obra&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Un hunk por dato que cambia; el resto queda de contexto&lt;/span&gt;" vertex="1">
          <mxGeometry x="340" y="450" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flujo-b5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;" value="&lt;b&gt;Calcula el impacto&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Afectados por dependencias; costo y plazo por reglas (partidas y ruta crítica)&lt;/span&gt;" vertex="1">
          <mxGeometry x="340" y="535" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="flujo-c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;" value="&lt;b&gt;Filtrado: para tu información&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«No te avisamos: …», con la razón (por ejemplo, la holgura)&lt;/span&gt;" vertex="1">
          <mxGeometry x="700" y="540" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flujo-b6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;" value="&lt;b&gt;Detecta solapamientos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Mismo elemento, misma área (nivel, celda, sistema) o simultáneo&lt;/span&gt;" vertex="1">
          <mxGeometry x="340" y="630" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="flujo-c6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;" value="&lt;b&gt;Validadores votan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Se tocan» bloquea la propuesta; «No se tocan» la libera&lt;/span&gt;" vertex="1">
          <mxGeometry x="700" y="635" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flujo-b7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#FFFFFF;strokeColor=#0F6E56;fontColor=#085041;dashed=1;" value="&lt;b&gt;Avisa en su canal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Correo, WhatsApp o Slack, maquetas en la web: resumen, costo, plazo y enlace a /cambios/:id&lt;/span&gt;" vertex="1">
          <mxGeometry x="340" y="725" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="flujo-a7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;" value="&lt;b&gt;Ve el estado en vivo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Quién aprobó, disputó o falta: /sala, /presentador, «Tus propuestas»&lt;/span&gt;" vertex="1">
          <mxGeometry x="60" y="730" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flujo-c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;" value="&lt;b&gt;Afectado responde&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«Revisado» o «Tengo un problema», con nota&lt;/span&gt;" vertex="1">
          <mxGeometry x="700" y="730" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flujo-b8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#FDF1E7;strokeColor=#B4690E;fontColor=#7A4508;dashed=1;" value="&lt;b&gt;Seguimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Recordatorios, escalamiento y silencio visible con nombre y hora&lt;/span&gt;" vertex="1">
          <mxGeometry x="340" y="820" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flujo-a8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#2C2C2A;" value="&lt;b&gt;Resuelve la disputa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Reabre con la observación, retira o sube una revisión nueva que reemplaza la propuesta&lt;/span&gt;" vertex="1">
          <mxGeometry x="60" y="820" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="flujo-c8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#FDF1E7;strokeColor=#B4690E;fontColor=#7A4508;dashed=1;" value="&lt;b&gt;Más respuestas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;«No me afecta» y «Me afecta» (mano alzada), que corrigen el mapa&lt;/span&gt;" vertex="1">
