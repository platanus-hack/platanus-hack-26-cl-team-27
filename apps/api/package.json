{
  "name": "@team27/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:api"
    ],
    "targets": {
      "test": {
        "inputs": [
          "...",
          "{workspaceRoot}/tool-use-case/revit/contract/minuta.example.json"
        ]
      },
      "build": {
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "dependsOn": [
          "^generate",
          "^typecheck",
          "typecheck"
        ]
      },
      "dev": {
        "continuous": true,
        "dependsOn": [
          "^generate",
          "^typecheck"
        ]
      },
      "start": {
        "continuous": true,
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@team27/context-capture": "workspace:*",
    "@team27/context-impact": "workspace:*",
    "@team27/context-inference": "workspace:*",
    "@team27/context-lake": "workspace:*",
    "@team27/context-notification": "workspace:*",
    "@team27/data-main": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2"
  }
}
