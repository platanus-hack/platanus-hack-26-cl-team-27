generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Change {
  projectId   String   @map("project_id")
  id          String   @id @default(uuid()) @db.Uuid
  sourceId    String   @map("source_id")
  elementId   String   @map("element_id")
  elementName String   @map("element_name")
  category    String
  kind        String
  summary     String
  diffs       Json
  before      Json
  after       Json
  detectedAt  DateTime @default(now()) @map("detected_at")

  @@index([projectId, detectedAt])
  @@index([sourceId])
  @@map("changes")
}

model Impact {
  projectId  String   @map("project_id")
  changeId   String   @id @map("change_id") @db.Uuid
  costDelta  Int      @map("cost_delta")
  delayDays  Int      @map("delay_days")
  detail     Json
  analyzedAt DateTime @default(now()) @map("analyzed_at")

  @@index([projectId])
  @@map("impacts")
}

model Notification {
  projectId     String    @map("project_id")
  id            String    @id @default(uuid()) @db.Uuid
  changeId      String    @map("change_id") @db.Uuid
  stakeholderId String    @map("stakeholder_id")
  channel       String
  title         String
  findings      Json
  link          String
  context       Json?
  sentAt        DateTime  @default(now()) @map("sent_at")
  response      String?
  responseNote  String?   @map("response_note")
  respondedAt   DateTime? @map("responded_at")
  deliveries    NotificationDelivery[]

  @@index([changeId])
  @@index([stakeholderId])
  @@index([projectId])
  @@map("notifications")
}

model NotificationDelivery {
  projectId      String       @map("project_id")
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String
  recipient      String?
  status         String       @default("pending")
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at")
  lastError      String?      @map("last_error")
  providerId     String?      @map("provider_id")
  sentAt         DateTime?    @map("sent_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([notificationId])
  @@map("notification_deliveries")
}

model Revision {
  projectId     String   @map("project_id")
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id")
  documentName  String   @map("document_name")
  label         String
  kind          String
  spaceId       String   @map("space_id")
  authorId      String   @map("author_id")
  contentHash   String   @map("content_hash")
  sourcePointer String   @map("source_pointer")
  ingestOrder   Int      @unique @default(autoincrement()) @map("ingest_order")
  ingestedAt    DateTime @default(now()) @map("ingested_at")
  chunks        Chunk[]
  claims        Claim[]

  @@unique([projectId, documentId, label])
  @@map("revisions")
}

model Chunk {
  projectId  String   @map("project_id")
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  position   Int
  locator    String
  kind       String
  text       String?
  rejected   Json     @default("[]")
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  claims     Claim[]

  @@index([revisionId])
  @@index([projectId])
  @@map("chunks")
}

model Claim {
  projectId  String   @map("project_id")
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  chunkId    String?  @map("chunk_id") @db.Uuid
  confidence Float?
  subject    String
  attribute  String
  value      Json
  unit       String?
  role       String
  locator    String
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  chunk      Chunk?   @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([revisionId])
  @@index([chunkId])
  @@index([projectId, subject, attribute])
  @@map("claims")
}

model BaselineEntry {
  projectId  String            @map("project_id")
  subject    String
  attribute  String
  value      Json
  unit       String?
  claimId    String?           @map("claim_id")
  revisionId String            @map("revision_id")
  proposalId String?           @map("proposal_id")
  since      DateTime          @default(now())
  version    Int               @default(1)
  history    BaselineHistory[]

  @@id([projectId, subject, attribute])
  @@map("baseline_entries")
}

model BaselineHistory {
  projectId  String        @map("project_id")
  id         String        @id @default(uuid()) @db.Uuid
  subject    String
  attribute  String
  value      Json
  unit       String?
  claimId    String?       @map("claim_id")
  revisionId String        @map("revision_id")
  proposalId String?       @map("proposal_id")
  since      DateTime
  until      DateTime
  entry      BaselineEntry @relation(fields: [projectId, subject, attribute], references: [projectId, subject, attribute], onDelete: Cascade)

  @@index([projectId, subject, attribute])
  @@map("baseline_history")
}

model Proposal {
  projectId        String    @map("project_id")
  id               String    @id @default(uuid()) @db.Uuid
  changeId         String?   @map("change_id")
  changeIds        Json      @default("[]") @map("change_ids")
  documentId       String    @map("document_id")
  sourceRevisionId String    @map("source_revision_id")
  authorId         String    @map("author_id")
  changes          Json
  context          Json      @default("[]")
  filtered         Json
  status           String
  openedAt         DateTime  @default(now()) @map("opened_at")
  resolvedAt       DateTime? @map("resolved_at")
  supersededById   String?   @map("superseded_by_id")
  reviews          Review[]

  @@index([projectId, status])
  @@index([documentId])
  @@map("proposals")
}

model Review {
  id         String    @id @default(uuid()) @db.Uuid
  proposalId String    @map("proposal_id") @db.Uuid
  reviewerId String    @map("reviewer_id")
  decision   String?
  note       String?
  at         DateTime?
  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, reviewerId])
  @@map("reviews")
}

model Discrepancy {
  projectId          String    @map("project_id")
  id                 String    @id @default(uuid()) @db.Uuid
  subject            String
  attribute          String
  value              Json
  baselineValue      Json      @map("baseline_value")
  unit               String?
  documentId         String    @map("document_id")
  revisionId         String    @map("revision_id")
  claimId            String?   @map("claim_id")
  ownerId            String    @map("owner_id")
  status             String    @default("open")
  backedByRevisionId String?   @map("backed_by_revision_id")
  note               String?
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime? @map("resolved_at")

  @@index([projectId, status])
  @@map("discrepancies")
}

model Acknowledgement {
  projectId  String   @map("project_id")
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id")
  revisionId String   @map("revision_id")
  signature  String
  ownerId    String   @map("owner_id")
  note       String
  at         DateTime @default(now())

  @@index([documentId])
  @@index([projectId])
  @@map("acknowledgements")
}

model Overlap {
  projectId       String        @map("project_id")
  id              String        @id @default(uuid()) @db.Uuid
  proposalId      String?       @map("proposal_id")
  otherProposalId String?       @map("other_proposal_id")
  revisionId      String        @map("revision_id")
  chunkLocator    String        @map("chunk_locator")
  kind            String
  nivel           String?
  celda           String?
  sistemas        Json
  relation        String?
  subjectId       String        @map("subject_id")
  otherSubjectId  String        @map("other_subject_id")
  otherBacking    Json          @map("other_backing")
  validators      Json
  status          String        @default("abierto")
  resolution      String?
  createdAt       DateTime      @default(now()) @map("created_at")
  resolvedAt      DateTime?     @map("resolved_at")
  votes           OverlapVote[]

  @@index([projectId, status])
  @@index([proposalId])
  @@map("overlaps")
}

model OverlapVote {
  id          String   @id @default(uuid()) @db.Uuid
  overlapId   String   @map("overlap_id") @db.Uuid
  validatorId String   @map("validator_id")
  kind        String
  note        String?
  at          DateTime @default(now())
  overlap     Overlap  @relation(fields: [overlapId], references: [id], onDelete: Cascade)

  @@unique([overlapId, validatorId])
  @@map("overlap_votes")
}

model ProjectEvent {
  projectId String   @map("project_id")
  seq       Int      @id @default(autoincrement())
  kind      String
  message   String
  refs      Json
  at        DateTime @default(now())

  @@index([projectId, seq])
  @@map("project_events")
}

model Organization {
  id            String         @id
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  projects      Project[]
  memberships   Membership[]
  invitations   Invitation[]
  apsConnection ApsConnection?

  @@map("organizations")
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  authSubject    String          @unique @map("auth_subject")
  email          String          @unique
  name           String?
  createdAt      DateTime        @default(now()) @map("created_at")
  memberships    Membership[]
  apsConnections ApsConnection[]

  @@map("users")
}

model Membership {
  organizationId String       @map("organization_id")
  userId         String       @map("user_id") @db.Uuid
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id")
  email          String
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")
  acceptedAt     DateTime?    @map("accepted_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
  @@map("invitations")
}

model Project {
  id               String       @id
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name             String
  location         String
  description      String
  authorId         String       @map("author_id")
  costOwnerId      String       @map("cost_owner_id")
  scheduleOwnerId  String       @map("schedule_owner_id")
  modelDocumentId  String?      @map("model_document_id")
  longitudinalAxes Json         @map("longitudinal_axes")
  transversalAxes  Int[]        @map("transversal_axes")
  createdAt        DateTime     @default(now()) @map("created_at")

  members      ProjectMember[]
  spaces       ProjectSpace[]
  documents    ProjectDocument[]
  attributes   ProjectAttribute[]
  subjects     ProjectSubject[]
  elements     ModelElement[]
  budgetItems  BudgetItem[]
  tasks        ScheduleTask[]
  dependencies ProjectDependency[]
  levels       ProjectLevel[]
  systems      ProjectSystem[]

  @@map("projects")
}

model ProjectMember {
  projectId String  @map("project_id")
  id        String
  position  Int
  name      String
  role      String
  channel   String
  handle    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("project_members")
}

model ProjectSpace {
  projectId String  @map("project_id")
  id        String
  position  Int
  name      String
  kind      String
  ownerId   String  @map("owner_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("project_spaces")
}

model ProjectDocument {
  projectId String  @map("project_id")
  id        String
  position  Int
  name      String
  kind      String
  spaceId   String  @map("space_id")
  ownerId   String  @map("owner_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("project_documents")
}

model ProjectAttribute {
  projectId String  @map("project_id")
  key       String
  position  Int
  label     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, key])
  @@map("project_attributes")
}

model ProjectSubject {
  projectId  String  @map("project_id")
  id         String
  position   Int
  name       String
  section    String
  category   String
  attributes Json
  spatial    Json?
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("project_subjects")
}

model ModelElement {
  projectId  String  @map("project_id")
  id         String
  position   Int
  name       String
  category   String
  level      Int?
  properties Json
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("model_elements")
}

model BudgetItem {
  projectId String  @map("project_id")
  code      String
  position  Int
  name      String
  unit      String
  unitPrice Int     @map("unit_price")
  category  String
  quantity  String
  factor    Float
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, code])
  @@map("budget_items")
}

model ScheduleTask {
  projectId    String   @map("project_id")
  id           String
  position     Int
  name         String
  days         Int
  predecessors String[]
  driver       Json?
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("schedule_tasks")
}

model ProjectDependency {
  projectId     String   @map("project_id")
  position      Int
  category      String
  watches       String[]
  stakeholderId String   @map("stakeholder_id")
  summary       String
  action        String
  measures      String[]
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, position])
  @@map("project_dependencies")
}

model ProjectLevel {
  projectId String  @map("project_id")
  id        String
  position  Int
  label     String
  short     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("project_levels")
}

model ProjectSystem {
  projectId     String  @map("project_id")
  id            String
  position      Int
  label         String
  occupiesSpace Boolean @map("occupies_space")
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@map("project_systems")
}

model IntegrationConnection {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  provider           String
  accountEmail       String              @map("account_email")
  scopes             String[]
  refreshTokenSealed String              @map("refresh_token_sealed")
  connectedAt        DateTime            @default(now()) @map("connected_at")
  sources            IntegrationSource[]

  @@unique([userId, provider])
  @@map("integration_connections")
}

model IntegrationSource {
  id              String                 @id @default(uuid()) @db.Uuid
  projectId       String                 @map("project_id")
  connectionId    String?                @map("connection_id") @db.Uuid
  provider        String
  externalId      String                 @map("external_id")
  title           String
  pointer         String
  contentHash     String?                @map("content_hash")
  checkedAt       DateTime?              @map("checked_at")
  changedAt       DateTime?              @map("changed_at")
  changedBy       Json?                  @map("changed_by")
  lastError       Json?                  @map("last_error")
  watchChannelId  String?                @unique @map("watch_channel_id")
  watchResourceId String?                @map("watch_resource_id")
  watchToken      String?                @map("watch_token")
  watchExpiresAt  DateTime?              @map("watch_expires_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  connection      IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([projectId, externalId])
  @@index([connectionId])
  @@map("integration_sources")
}

model ApsConnection {
  organizationId         String       @id @map("organization_id")
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedById          String?      @map("connected_by_id") @db.Uuid
  connectedBy            User?        @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  autodeskUserId         String       @map("autodesk_user_id")
  autodeskEmail          String?      @map("autodesk_email")
  autodeskName           String?      @map("autodesk_name")
  scopes                 String
  accessTokenCiphertext  String       @map("access_token_ciphertext")
  refreshTokenCiphertext String       @map("refresh_token_ciphertext")
  expiresAt              DateTime     @map("expires_at")
  refreshedAt            DateTime     @map("refreshed_at")
  status                 String
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  @@index([connectedById])
  @@map("aps_connections")
}

model AutodeskEvent {
  id               String    @id @default(uuid()) @db.Uuid
  dedupeKey        String    @unique @map("dedupe_key")
  event            String
  kind             String
  source           String
  hookId           String?   @map("hook_id")
  resourceKind     String    @map("resource_kind")
  resourceUrn      String?   @map("resource_urn")
  lineageUrn       String?   @map("lineage_urn")
  name             String?
  version          Int?
  folderUrn        String?   @map("folder_urn")
  projectId        String?   @map("project_id")
  actorId          String?   @map("actor_id")
  occurredAt       DateTime? @map("occurred_at")
  needsElementDiff Boolean   @map("needs_element_diff")
  receivedAt       DateTime  @default(now()) @map("received_at")

  @@index([lineageUrn])
  @@map("autodesk_events")
}
