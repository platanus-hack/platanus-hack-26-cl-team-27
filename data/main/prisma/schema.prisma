generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Change {
  id          String   @id @default(uuid()) @db.Uuid
  sourceId    String   @map("source_id")
  elementId   String   @map("element_id")
  elementName String   @map("element_name")
  category    String
  kind        String
  summary     String
  diffs       Json
  before      Json
  after       Json
  detectedAt  DateTime @default(now()) @map("detected_at")

  @@index([detectedAt])
  @@index([sourceId])
  @@map("changes")
}

model Impact {
  changeId   String   @id @map("change_id") @db.Uuid
  costDelta  Int      @map("cost_delta")
  delayDays  Int      @map("delay_days")
  detail     Json
  analyzedAt DateTime @default(now()) @map("analyzed_at")

  @@map("impacts")
}

model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  changeId      String    @map("change_id") @db.Uuid
  stakeholderId String    @map("stakeholder_id")
  channel       String
  title         String
  findings      Json
  link          String
  sentAt        DateTime  @default(now()) @map("sent_at")
  response      String?
  responseNote  String?   @map("response_note")
  respondedAt   DateTime? @map("responded_at")

  @@index([changeId])
  @@index([stakeholderId])
  @@map("notifications")
}

model Revision {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id")
  documentName  String   @map("document_name")
  label         String
  kind          String
  spaceId       String   @map("space_id")
  authorId      String   @map("author_id")
  contentHash   String   @map("content_hash")
  sourcePointer String   @map("source_pointer")
  ingestOrder   Int      @unique @default(autoincrement()) @map("ingest_order")
  ingestedAt    DateTime @default(now()) @map("ingested_at")
  chunks        Chunk[]
  claims        Claim[]

  @@unique([documentId, label])
  @@map("revisions")
}

model Chunk {
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  position   Int
  locator    String
  kind       String
  text       String?
  rejected   Json     @default("[]")
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  claims     Claim[]

  @@index([revisionId])
  @@map("chunks")
}

model Claim {
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  chunkId    String?  @map("chunk_id") @db.Uuid
  confidence Float?
  subject    String
  attribute  String
  value      Json
  unit       String?
  role       String
  locator    String
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  chunk      Chunk?   @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([revisionId])
  @@index([chunkId])
  @@index([subject, attribute])
  @@map("claims")
}

model BaselineEntry {
  subject    String
  attribute  String
  value      Json
  unit       String?
  claimId    String?           @map("claim_id")
  revisionId String            @map("revision_id")
  proposalId String?           @map("proposal_id")
  since      DateTime          @default(now())
  version    Int               @default(1)
  history    BaselineHistory[]

  @@id([subject, attribute])
  @@map("baseline_entries")
}

model BaselineHistory {
  id         String        @id @default(uuid()) @db.Uuid
  subject    String
  attribute  String
  value      Json
  unit       String?
  claimId    String?       @map("claim_id")
  revisionId String        @map("revision_id")
  proposalId String?       @map("proposal_id")
  since      DateTime
  until      DateTime
  entry      BaselineEntry @relation(fields: [subject, attribute], references: [subject, attribute], onDelete: Cascade)

  @@index([subject, attribute])
  @@map("baseline_history")
}

model Proposal {
  id               String    @id @default(uuid()) @db.Uuid
  changeId         String?   @map("change_id")
  changeIds        Json      @default("[]") @map("change_ids")
  documentId       String    @map("document_id")
  sourceRevisionId String    @map("source_revision_id")
  authorId         String    @map("author_id")
  changes          Json
  context          Json      @default("[]")
  filtered         Json
  status           String
  openedAt         DateTime  @default(now()) @map("opened_at")
  resolvedAt       DateTime? @map("resolved_at")
  supersededById   String?   @map("superseded_by_id")
  reviews          Review[]

  @@index([status])
  @@index([documentId])
  @@map("proposals")
}

model Review {
  id         String    @id @default(uuid()) @db.Uuid
  proposalId String    @map("proposal_id") @db.Uuid
  reviewerId String    @map("reviewer_id")
  decision   String?
  note       String?
  at         DateTime?
  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, reviewerId])
  @@map("reviews")
}

model Discrepancy {
  id                 String    @id @default(uuid()) @db.Uuid
  subject            String
  attribute          String
  value              Json
  baselineValue      Json      @map("baseline_value")
  unit               String?
  documentId         String    @map("document_id")
  revisionId         String    @map("revision_id")
  claimId            String?   @map("claim_id")
  ownerId            String    @map("owner_id")
  status             String    @default("open")
  backedByRevisionId String?   @map("backed_by_revision_id")
  note               String?
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime? @map("resolved_at")

  @@index([status])
  @@map("discrepancies")
}

model Acknowledgement {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id")
  revisionId String   @map("revision_id")
  signature  String
  ownerId    String   @map("owner_id")
  note       String
  at         DateTime @default(now())

  @@index([documentId])
  @@map("acknowledgements")
}

model Overlap {
  id              String        @id @default(uuid()) @db.Uuid
  proposalId      String?       @map("proposal_id")
  otherProposalId String?       @map("other_proposal_id")
  revisionId      String        @map("revision_id")
  chunkLocator    String        @map("chunk_locator")
  kind            String
  nivel           String?
  celda           String?
  sistemas        Json
  relation        String?
  subjectId       String        @map("subject_id")
  otherSubjectId  String        @map("other_subject_id")
  otherBacking    Json          @map("other_backing")
  validators      Json
  status          String        @default("abierto")
  resolution      String?
  createdAt       DateTime      @default(now()) @map("created_at")
  resolvedAt      DateTime?     @map("resolved_at")
  votes           OverlapVote[]

  @@index([status])
  @@index([proposalId])
  @@map("overlaps")
}

model OverlapVote {
  id          String   @id @default(uuid()) @db.Uuid
  overlapId   String   @map("overlap_id") @db.Uuid
  validatorId String   @map("validator_id")
  kind        String
  note        String?
  at          DateTime @default(now())
  overlap     Overlap  @relation(fields: [overlapId], references: [id], onDelete: Cascade)

  @@unique([overlapId, validatorId])
  @@map("overlap_votes")
}

model Seat {
  castId     String   @id @map("cast_id")
  tokenHash  String   @map("token_hash")
  claimedAt  DateTime @default(now()) @map("claimed_at")
  lastBeatAt DateTime @default(now()) @map("last_beat_at")

  @@map("seats")
}

model RoomEvent {
  seq     Int      @id @default(autoincrement())
  epoch   Int
  kind    String
  message String
  refs    Json
  at      DateTime @default(now())

  @@index([epoch])
  @@map("room_events")
}

model RoomState {
  id    Int @id
  epoch Int @default(1)

  @@map("room_state")
}

model IntegrationConnection {
  id                 String              @id @default(uuid()) @db.Uuid
  provider           String              @unique
  accountEmail       String              @map("account_email")
  scopes             String[]
  refreshTokenSealed String              @map("refresh_token_sealed")
  connectedAt        DateTime            @default(now()) @map("connected_at")
  sources            IntegrationSource[]

  @@map("integration_connections")
}

model IntegrationSource {
  id           String                @id @default(uuid()) @db.Uuid
  connectionId String                @map("connection_id") @db.Uuid
  provider     String
  externalId   String                @map("external_id")
  documentId   String                @unique @map("document_id")
  title        String
  pointer      String
  checkedAt    DateTime?             @map("checked_at")
  lastRead     Json?                 @map("last_read")
  lastError    Json?                 @map("last_error")
  createdAt    DateTime              @default(now()) @map("created_at")
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("integration_sources")
}
