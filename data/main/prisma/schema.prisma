generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Snapshot {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @map("integration_id")
  version       Int
  elements      Json
  publishedAt   DateTime @default(now()) @map("published_at")

  @@unique([integrationId, version])
  @@map("snapshots")
}

model Change {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @map("integration_id")
  version       Int
  elementId     String   @map("element_id")
  elementName   String   @map("element_name")
  category      String
  kind          String
  summary       String
  diffs         Json
  before        Json
  after         Json
  detectedAt    DateTime @default(now()) @map("detected_at")

  @@index([detectedAt])
  @@map("changes")
}

model Impact {
  changeId   String   @id @map("change_id") @db.Uuid
  costDelta  Int      @map("cost_delta")
  delayDays  Int      @map("delay_days")
  detail     Json
  analyzedAt DateTime @default(now()) @map("analyzed_at")

  @@map("impacts")
}

model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  changeId      String    @map("change_id") @db.Uuid
  stakeholderId String    @map("stakeholder_id")
  channel       String
  title         String
  findings      Json
  link          String
  sentAt        DateTime  @default(now()) @map("sent_at")
  response      String?
  responseNote  String?   @map("response_note")
  respondedAt   DateTime? @map("responded_at")

  @@index([changeId])
  @@index([stakeholderId])
  @@map("notifications")
}
