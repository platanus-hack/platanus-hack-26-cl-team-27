generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Change {
  id          String   @id @default(uuid()) @db.Uuid
  sourceId    String   @map("source_id")
  elementId   String   @map("element_id")
  elementName String   @map("element_name")
  category    String
  kind        String
  summary     String
  diffs       Json
  before      Json
  after       Json
  detectedAt  DateTime @default(now()) @map("detected_at")

  @@index([detectedAt])
  @@index([sourceId])
  @@map("changes")
}

model Impact {
  changeId   String   @id @map("change_id") @db.Uuid
  costDelta  Int      @map("cost_delta")
  delayDays  Int      @map("delay_days")
  detail     Json
  analyzedAt DateTime @default(now()) @map("analyzed_at")

  @@map("impacts")
}

model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  changeId      String    @map("change_id") @db.Uuid
  stakeholderId String    @map("stakeholder_id")
  channel       String
  title         String
  findings      Json
  link          String
  sentAt        DateTime  @default(now()) @map("sent_at")
  response      String?
  responseNote  String?   @map("response_note")
  respondedAt   DateTime? @map("responded_at")

  @@index([changeId])
  @@index([stakeholderId])
  @@map("notifications")
}

model Revision {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id")
  documentName  String   @map("document_name")
  label         String
  kind          String
  spaceId       String   @map("space_id")
  authorId      String   @map("author_id")
  contentHash   String   @map("content_hash")
  sourcePointer String   @map("source_pointer")
  ingestOrder   Int      @unique @default(autoincrement()) @map("ingest_order")
  ingestedAt    DateTime @default(now()) @map("ingested_at")
  claims        Claim[]

  @@unique([documentId, label])
  @@map("revisions")
}

model Claim {
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  subject    String
  attribute  String
  value      Json
  unit       String?
  role       String
  locator    String
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId])
  @@index([subject, attribute])
  @@map("claims")
}

model BaselineEntry {
  subject    String
  attribute  String
  value      Json
  unit       String?
  claimId    String?           @map("claim_id")
  revisionId String            @map("revision_id")
  proposalId String?           @map("proposal_id")
  since      DateTime          @default(now())
  version    Int               @default(1)
  history    BaselineHistory[]

  @@id([subject, attribute])
  @@map("baseline_entries")
}

model BaselineHistory {
  id         String        @id @default(uuid()) @db.Uuid
  subject    String
  attribute  String
  value      Json
  unit       String?
  claimId    String?       @map("claim_id")
  revisionId String        @map("revision_id")
  proposalId String?       @map("proposal_id")
  since      DateTime
  until      DateTime
  entry      BaselineEntry @relation(fields: [subject, attribute], references: [subject, attribute], onDelete: Cascade)

  @@index([subject, attribute])
  @@map("baseline_history")
}

model Proposal {
  id               String    @id @default(uuid()) @db.Uuid
  changeId         String?   @map("change_id")
  subject          String
  sourceRevisionId String    @map("source_revision_id")
  authorId         String    @map("author_id")
  changes          Json
  filtered         Json
  status           String
  openedAt         DateTime  @default(now()) @map("opened_at")
  resolvedAt       DateTime? @map("resolved_at")
  supersededById   String?   @map("superseded_by_id")
  reviews          Review[]

  @@index([status])
  @@index([subject])
  @@map("proposals")
}

model Review {
  id         String    @id @default(uuid()) @db.Uuid
  proposalId String    @map("proposal_id") @db.Uuid
  reviewerId String    @map("reviewer_id")
  decision   String?
  note       String?
  at         DateTime?
  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, reviewerId])
  @@map("reviews")
}

model Discrepancy {
  id                 String    @id @default(uuid()) @db.Uuid
  subject            String
  attribute          String
  value              Json
  baselineValue      Json      @map("baseline_value")
  unit               String?
  documentId         String    @map("document_id")
  revisionId         String    @map("revision_id")
  claimId            String?   @map("claim_id")
  ownerId            String    @map("owner_id")
  status             String    @default("open")
  backedByRevisionId String?   @map("backed_by_revision_id")
  note               String?
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime? @map("resolved_at")

  @@index([status])
  @@map("discrepancies")
}

model Acknowledgement {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id")
  revisionId String   @map("revision_id")
  signature  String
  ownerId    String   @map("owner_id")
  note       String
  at         DateTime @default(now())

  @@index([documentId])
  @@map("acknowledgements")
}

model Seat {
  castId     String   @id @map("cast_id")
  tokenHash  String   @map("token_hash")
  claimedAt  DateTime @default(now()) @map("claimed_at")
  lastBeatAt DateTime @default(now()) @map("last_beat_at")

  @@map("seats")
}

model RoomEvent {
  seq     Int      @id @default(autoincrement())
  epoch   Int
  kind    String
  message String
  refs    Json
  at      DateTime @default(now())

  @@index([epoch])
  @@map("room_events")
}

model BotTask {
  id      String    @id @default(uuid()) @db.Uuid
  key     String    @unique
  castId  String    @map("cast_id")
  kind    String
  payload Json
  dueAt   DateTime  @map("due_at")
  doneAt  DateTime? @map("done_at")
  result  String?

  @@index([doneAt, dueAt])
  @@map("bot_tasks")
}

model RoomState {
  id          Int       @id
  epoch       Int       @default(1)
  autoplay    Boolean   @default(false)
  speed       Int       @default(1)
  activeScene String?   @map("active_scene")
  pauseUntil  DateTime? @map("pause_until")

  @@map("room_state")
}
