<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Company>Team 27</Company>
    <Product>Team27.Minuta</Product>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Team27.Minuta.Revit'">
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <BaseIntermediateOutputPath>obj\$(RevitVersion)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\$(RevitVersion)\</BaseOutputPath>
  </PropertyGroup>
</Project>
