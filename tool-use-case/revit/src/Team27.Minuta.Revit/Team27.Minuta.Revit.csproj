<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' != '2027'">net8.0-windows</TargetFramework>
    <RootNamespace>Team27.Minuta.Revit</RootNamespace>
    <AssemblyName>Team27.Minuta.Revit</AssemblyName>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2025'">2025.4.60</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2026'">2026.4.10</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2027'">2027.4.0</RevitApiVersion>
    <RevitAddinsFolder>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinsFolder>
    <DeployToRevit Condition="'$(DeployToRevit)' == '' and '$(OS)' == 'Windows_NT'">true</DeployToRevit>
  </PropertyGroup>

  <ItemGroup Condition="'$(RevitApiVersion)' != ''">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Team27.Minuta.Core\Team27.Minuta.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Team27.Minuta.addin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="minuta.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckRevitVersion" BeforeTargets="CollectPackageReferences;BeforeBuild">
    <Error Condition="'$(RevitApiVersion)' == ''" Text="RevitVersion debe ser 2025, 2026 o 2027, y llegó «$(RevitVersion)». Ejemplo: dotnet build -p:RevitVersion=2026" />
  </Target>

  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(DeployToRevit)' == 'true'">
    <ItemGroup>
      <MinutaBinaries Include="$(OutDir)Team27.Minuta.Revit.dll;$(OutDir)Team27.Minuta.Core.dll;$(OutDir)Team27.Minuta.Revit.pdb;$(OutDir)Team27.Minuta.Core.pdb" />
    </ItemGroup>
    <Copy SourceFiles="$(OutDir)Team27.Minuta.addin" DestinationFolder="$(RevitAddinsFolder)" />
    <Copy SourceFiles="@(MinutaBinaries)" DestinationFolder="$(RevitAddinsFolder)\Team27.Minuta" Condition="Exists('%(FullPath)')" />
    <Copy SourceFiles="$(OutDir)minuta.config.json" DestinationFolder="$(RevitAddinsFolder)\Team27.Minuta" Condition="!Exists('$(RevitAddinsFolder)\Team27.Minuta\minuta.config.json')" />
    <Message Importance="high" Text="Add-in instalado en $(RevitAddinsFolder)" />
  </Target>
</Project>
