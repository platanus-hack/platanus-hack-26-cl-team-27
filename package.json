{
  "name": "@team27/source",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "nx run-many -t dev -p @team27/api @team27/web",
    "dev:api": "nx run @team27/api:dev",
    "dev:web": "nx run @team27/web:dev",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "check": "nx run-many -t lint test typecheck build",
    "affected": "nx affected -t lint test typecheck build",
    "gmail:auth": "node --env-file-if-exists=.env apps/api/src/cli/gmail-auth.ts",
    "aps:check": "node --env-file-if-exists=.env apps/aps/src/main.ts check",
    "aps:models": "node --env-file-if-exists=.env apps/aps/src/main.ts models",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter @team27/data-main migrate:deploy",
    "db:seed": "pnpm --filter @team27/data-main seed",
    "db:studio": "pnpm --filter @team27/data-main studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/next": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "~5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "5.0.0",
    "nx": "24.0.6",
    "prettier": "~3.10.1",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "~5.1.1"
  }
}
